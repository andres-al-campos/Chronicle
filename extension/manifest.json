{
  "manifest_version": 3,
  "name": "Chronicle Export",
  "version": "0.4.0",
  "description": "Export Claude.ai conversations for the Chronicle pipeline.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["changes.js", "content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["session.js", "changes.js", "background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "chronicle-export@local",
      "strict_min_version": "127.0"
    }
  }
}
